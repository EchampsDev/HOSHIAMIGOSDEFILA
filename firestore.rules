rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isConstellationContributor() {
      return signedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'CONSTELLATION_CONTRIBUTOR';
    }

    // Admin roles are bootstrapped from the Firebase console or Admin SDK only.
    match /admins/{userId} {
      // Each signed-in account may only verify its own role; role documents remain immutable from the client.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Perfiles de acceso: la cuenta crea únicamente su propio perfil inicial USER.
    // Sólo la cuenta administradora puede convertir a alguien en colaborador, especial o invitado.
    match /userRoles/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['role', 'displayName', 'email', 'createdAt', 'lastSignInAt'])
        && request.resource.data.role == 'USER'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'lastSignInAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160);
      allow delete: if isAdmin();
    }

    // Registro mínimo de participación: nombre visible y marcas de inicio de sesión.
    // Cada cuenta sólo puede acceder a su propio documento; no hay lectura masiva.
    match /participantSessions/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'lastSignInAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastSignInAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow delete: if false;
    }

    match /siteConfig/{document} {
      allow get: if true;
      allow list: if false;
      // Colaboradores aprobados sólo pueden editar la silueta compartida.
      allow create, update: if isAdmin() || (document == 'constellation' && isConstellationContributor());
      allow delete: if isAdmin();
    }

    match /pages/{pageId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /elements/{elementId} {
      allow get, list: if resource.data.moderationStatus == 'APPROVED'
        && resource.data.consent.contentVisibility == 'PUBLIC';
      allow create: if signedIn()
        && request.resource.data.moderationStatus == 'PENDING'
        && request.resource.data.participantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Fuente editorial privada. Sólo administración puede crear o mutar noticias.
    match /news/{newsId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      // El slug queda congelado desde la primera publicación para conservar enlaces compartidos.
      allow update: if isAdmin()
        && (!('publishedAt' in resource.data)
          || request.resource.data.slug == resource.data.slug)
        // La primera transición a published debe incluir el evento outbox en la misma transacción.
        && (!(request.resource.data.status == 'published' && resource.data.status != 'published')
          || existsAfter(/databases/$(database)/documents/newsPublishingEvents/$(newsId)));
    }

    // Reserva transaccional de slugs para evitar URLs ambiguas o reutilizadas.
    match /newsSlugs/{slug} {
      allow read, create, update, delete: if isAdmin();
    }

    // Proyección pública creada al publicar; los borradores nunca se copian aquí.
    match /publishedNews/{newsId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && request.resource.data.status == 'published'
        && request.resource.data.visible == true
        && getAfter(/databases/$(database)/documents/news/$(newsId)).data.status == 'published';
      allow delete: if isAdmin();
    }

    // Outbox idempotente: un documento por primera publicación de cada noticia.
    match /newsPublishingEvents/{newsId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.type == 'NEWS_PUBLISHED'
        && request.resource.data.newsId == newsId;
      allow update, delete: if false;
    }

    // Consentimiento y entregas pertenecen al backend. El cliente admin sólo puede auditar.
    match /whatsappSubscribers/{subscriberId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /newsDeliveries/{deliveryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Reserved for the future comments feature. Public visitors can only read approved comments.
    match /comments/{commentId} {
      allow get, list: if resource.data.moderationStatus == 'APPROVED';
      allow create: if signedIn()
        && request.resource.data.moderationStatus == 'PENDING'
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Denegación por defecto: toda colección nueva debe declarar su contrato explícitamente.
    match /{document=**} { allow read, write: if false; }
  }
}
