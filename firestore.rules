rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
          && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }
    function isConstellationContributor() {
      return signedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'CONSTELLATION_CONTRIBUTOR';
    }
    function isSpecialGuest() {
      return signedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'SPECIAL';
    }
    function validSetlistEntry(entry) {
      return entry is map
        && entry.keys().hasAll(['id', 'title'])
        && entry.keys().hasOnly(['id', 'title', 'coverUrl'])
        && entry.id is string && entry.id.size() <= 160
        && entry.title is string && entry.title.size() <= 180
        && (!('coverUrl' in entry) || (entry.coverUrl is string && entry.coverUrl.size() <= 500));
    }

    function reservationAfter(pageNumber) {
      return getAfter(/databases/$(database)/documents/pageReservations/$(string(pageNumber)));
    }
    function submittedAfter(contributionId) {
      return getAfter(/databases/$(database)/documents/contributions/$(contributionId));
    }
    function validReservationPayload(pageId) {
      return signedIn()
        && request.resource.data.keys().hasAll(['pageNumber', 'pendingMain', 'pendingStickers', 'lastSubmissionId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['pageNumber', 'pendingMain', 'pendingStickers', 'lastSubmissionId', 'updatedAt'])
        && request.resource.data.pageNumber is int
        && request.resource.data.pageNumber >= 1
        && request.resource.data.pageNumber <= 100
        && pageId == string(request.resource.data.pageNumber)
        && !exists(/databases/$(database)/documents/pageLocks/$(pageId))
        && request.resource.data.pendingMain is int
        && request.resource.data.pendingStickers is int
        && request.resource.data.pendingMain >= 0
        && request.resource.data.pendingMain <= 4
        && request.resource.data.pendingStickers >= 0
        && request.resource.data.pendingStickers <= 10
        && request.resource.data.lastSubmissionId is string
        && request.resource.data.lastSubmissionId.matches('[0-9a-f-]{36}')
        && request.resource.data.updatedAt is string
        && !exists(/databases/$(database)/documents/contributions/$(request.resource.data.lastSubmissionId))
        && submittedAfter(request.resource.data.lastSubmissionId).data.participantId == request.auth.uid
        && submittedAfter(request.resource.data.lastSubmissionId).data.pageNumber == request.resource.data.pageNumber
        && submittedAfter(request.resource.data.lastSubmissionId).data.status == 'PENDING';
    }

    // Admin roles are bootstrapped from the Firebase console or Admin SDK only.
    match /admins/{userId} {
      // Each signed-in account may only verify its own role; role documents remain immutable from the client.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Perfiles de acceso: la cuenta crea únicamente su propio perfil inicial USER.
    // Sólo la cuenta administradora puede convertir a alguien en colaborador, especial o invitado.
    match /userRoles/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['role', 'displayName', 'email', 'createdAt', 'lastSignInAt'])
        && request.resource.data.role == 'USER'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'lastSignInAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160);
      allow delete: if isAdmin();
    }

    // Registro mínimo de participación: nombre visible y marcas de inicio de sesión.
    // Cada cuenta sólo puede acceder a su propio documento; no hay lectura masiva.
    match /participantSessions/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'lastSignInAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'lastSignInAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100;
      allow delete: if false;
    }

    match /siteConfig/{document} {
      allow get: if true;
      allow list: if false;
      // Colaboradores aprobados sólo pueden editar la silueta compartida.
      allow create, update: if isAdmin() || (document == 'constellation' && isConstellationContributor());
      allow delete: if isAdmin();
    }

    // Envío aislado de Bratty. La cuenta especial puede reemplazar la entrega
    // actual; administración conserva el control editorial de la sorpresa.
    match /brattySubmissions/{submissionId} {
      allow get: if submissionId == 'current';
      allow list: if false;
      allow create, update: if submissionId == 'current'
        && (isAdmin() || isSpecialGuest())
        && request.resource.data.keys().hasOnly(['authorName', 'message', 'videoUrl', 'storagePath', 'originalName', 'contentType', 'uploadedAt'])
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.videoUrl is string
        && request.resource.data.storagePath == 'bratty-surprise/current/video'
        && request.resource.data.originalName is string
        && request.resource.data.originalName.size() <= 180
        && request.resource.data.contentType is string
        && request.resource.data.contentType.matches('video/.*')
        && request.resource.data.uploadedAt is string;
      allow delete: if isAdmin();
    }

    match /pages/{pageId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Sólo publica conteos. La cuenta debe crear una aportación propia
    // en el mismo commit que aumenta la reserva.
    match /pageReservations/{pageId} {
      allow read: if true;
      allow create: if isAdmin() || (validReservationPayload(pageId)
        && ((submittedAfter(request.resource.data.lastSubmissionId).data.type == 'STICKER'
          && request.resource.data.pendingMain == 0 && request.resource.data.pendingStickers == 1)
          || (submittedAfter(request.resource.data.lastSubmissionId).data.type != 'STICKER'
          && request.resource.data.pendingMain == 1 && request.resource.data.pendingStickers == 0)));
      allow update: if isAdmin() || (validReservationPayload(pageId)
        && request.resource.data.pageNumber == resource.data.pageNumber
        && ((submittedAfter(request.resource.data.lastSubmissionId).data.type == 'STICKER'
          && request.resource.data.pendingMain == resource.data.pendingMain
          && request.resource.data.pendingStickers == resource.data.pendingStickers + 1)
          || (submittedAfter(request.resource.data.lastSubmissionId).data.type != 'STICKER'
          && request.resource.data.pendingMain == resource.data.pendingMain + 1
          && request.resource.data.pendingStickers == resource.data.pendingStickers)));
      allow delete: if isAdmin();
    }

    // Reservas manuales de caras. Son públicas para que la recomendación pueda
    // excluirlas, pero únicamente administración puede crearlas o retirarlas.
    match /pageLocks/{pageId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['pageNumber', 'reserved', 'reservedAt', 'reservedBy'])
        && request.resource.data.keys().hasOnly(['pageNumber', 'reserved', 'reservedAt', 'reservedBy'])
        && request.resource.data.pageNumber is int
        && request.resource.data.pageNumber >= 1
        && request.resource.data.pageNumber <= 100
        && pageId == string(request.resource.data.pageNumber)
        && request.resource.data.reserved == true
        && request.resource.data.reservedAt is string
        && request.resource.data.reservedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /elements/{elementId} {
      allow get, list: if resource.data.moderationStatus == 'APPROVED'
        && resource.data.consent.contentVisibility == 'PUBLIC';
      allow create: if signedIn()
        && request.resource.data.moderationStatus == 'PENDING'
        && request.resource.data.participantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Bandeja privada de aportaciones: el usuario sólo crea su propio envío
    // pendiente; administración es la única autoridad que modera y publica.
    match /contributions/{contributionId} {
      // La transacción idempotente consulta primero su UUID nuevo. Permitimos esa
      // lectura negativa a cuentas autenticadas, sin exponer aportaciones ajenas.
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/contributions/$(contributionId))
        || resource.data.participantId == request.auth.uid
        || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['id', 'participantId', 'author', 'type', 'pageNumber', 'visibility', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'participantId', 'author', 'type', 'pageNumber', 'visibility', 'status', 'createdAt', 'updatedAt', 'content', 'media', 'setlist', 'styleVariant', 'stickerId'])
        && request.resource.data.id == contributionId
        && reservationAfter(request.resource.data.pageNumber).data.lastSubmissionId == contributionId
        && contributionId.size() <= 100
        && request.resource.data.participantId == request.auth.uid
        && request.resource.data.author is map
        && request.resource.data.author.keys().hasOnly(['participantId', 'displayName', 'age'])
        && request.resource.data.author.participantId == request.auth.uid
        && (!('displayName' in request.resource.data.author) || (request.resource.data.author.displayName is string && request.resource.data.author.displayName.size() <= 100))
        && (!('age' in request.resource.data.author) || (request.resource.data.author.age is int && request.resource.data.author.age >= 1 && request.resource.data.author.age <= 120))
        && request.resource.data.status == 'PENDING'
        && request.resource.data.type in ['PHOTO', 'POST_IT', 'STICKER', 'TEXT', 'SETLIST']
        && request.resource.data.pageNumber is int
        && request.resource.data.pageNumber >= 1
        && request.resource.data.pageNumber <= 100
        && request.resource.data.visibility in ['PUBLIC', 'PRIVATE']
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 500))
        && ((request.resource.data.type == 'SETLIST'
          && request.resource.data.setlist is list
          && request.resource.data.setlist.size() == 3
          && validSetlistEntry(request.resource.data.setlist[0])
          && validSetlistEntry(request.resource.data.setlist[1])
          && validSetlistEntry(request.resource.data.setlist[2]))
          || (request.resource.data.type != 'SETLIST' && !('setlist' in request.resource.data)))
        && (!('styleVariant' in request.resource.data) || (request.resource.data.styleVariant is string && request.resource.data.styleVariant.size() <= 40))
        && (!('stickerId' in request.resource.data) || (request.resource.data.stickerId is string && request.resource.data.stickerId.size() <= 160))
        && ((request.resource.data.type == 'PHOTO' && request.resource.data.media is map
          && request.resource.data.media.keys().hasAll(['provider', 'objectKey', 'downloadUrl', 'mimeType', 'fileSize', 'originalWidth', 'originalHeight'])
          && request.resource.data.media.keys().hasOnly(['provider', 'objectKey', 'downloadUrl', 'mimeType', 'fileSize', 'originalWidth', 'originalHeight', 'displayWidth', 'displayHeight'])
          && request.resource.data.media.provider == 'r2'
          && request.resource.data.media.objectKey is string
          && request.resource.data.media.objectKey.matches('photos/' + contributionId + '[.](jpg|png|webp)')
          && request.resource.data.media.downloadUrl is string && request.resource.data.media.downloadUrl.size() <= 500
          && request.resource.data.media.mimeType in ['image/jpeg', 'image/png', 'image/webp']
          && request.resource.data.media.fileSize is int && request.resource.data.media.fileSize > 0 && request.resource.data.media.fileSize <= 5242880
          && request.resource.data.media.originalWidth is int && request.resource.data.media.originalWidth > 0
          && request.resource.data.media.originalHeight is int && request.resource.data.media.originalHeight > 0)
          || (request.resource.data.type != 'PHOTO' && !('media' in request.resource.data)));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'updatedAt', 'pageNumber', 'movedAt', 'movedBy', 'deletedAt', 'deletedBy'])
        && resource.data.status in ['PENDING', 'APPROVED']
        && ((request.resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pageNumber', 'movedAt', 'movedBy', 'updatedAt']))
          || (resource.data.status == 'PENDING' && request.resource.data.status in ['APPROVED', 'REJECTED', 'DELETED'])
          || (resource.data.status == 'APPROVED' && request.resource.data.status == 'DELETED'))
        && (!('pageNumber' in request.resource.data) || (request.resource.data.pageNumber is int && request.resource.data.pageNumber >= 1 && request.resource.data.pageNumber <= 100));
      allow delete: if isAdmin();
    }

    // Proyección mínima consultada por el Worker para servir únicamente fotos
    // ya aprobadas, sin exponer el contenido privado de moderación.
    match /approvedMedia/{mediaId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['objectKey', 'visibility', 'approvedAt'])
        && request.resource.data.objectKey is string
        && request.resource.data.objectKey.matches('photos/' + mediaId + '[.](jpg|png|webp)')
        && request.resource.data.visibility in ['PUBLIC', 'PRIVATE']
        && request.resource.data.approvedAt is string;
      allow delete: if isAdmin();
    }

    // Biblioteca comunitaria: el archivo vive en R2 y este documento conserva
    // únicamente metadata y estado editorial. Sólo APPROVED + PUBLIC es público.
    match /communityStickers/{stickerId} {
      allow get, list: if resource.data.publicApproved == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['id', 'ownerUid', 'title', 'assetUrl', 'objectKey', 'provider', 'mimeType', 'fileSize', 'originalWidth', 'originalHeight', 'safeFileName', 'status', 'visibility', 'publicApproved', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'ownerUid', 'title', 'authorName', 'description', 'assetUrl', 'objectKey', 'provider', 'mimeType', 'fileSize', 'originalWidth', 'originalHeight', 'displayWidth', 'displayHeight', 'safeFileName', 'status', 'visibility', 'publicApproved', 'createdAt', 'updatedAt'])
        && request.resource.data.id == stickerId
        && stickerId.matches('[0-9a-f-]+')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && (!('authorName' in request.resource.data) || (request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60))
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 240))
        && request.resource.data.assetUrl is string && request.resource.data.assetUrl.size() <= 500
        && request.resource.data.objectKey is string
        && request.resource.data.objectKey.matches('stickers/' + stickerId + '[.](png|webp)')
        && request.resource.data.provider == 'r2'
        && request.resource.data.mimeType in ['image/png', 'image/webp']
        && request.resource.data.fileSize is int && request.resource.data.fileSize > 0 && request.resource.data.fileSize <= 5242880
        && request.resource.data.originalWidth is int && request.resource.data.originalWidth >= 32 && request.resource.data.originalWidth <= 1300
        && request.resource.data.originalHeight is int && request.resource.data.originalHeight >= 32 && request.resource.data.originalHeight <= 1800
        && request.resource.data.safeFileName is string && request.resource.data.safeFileName.size() <= 160
        && request.resource.data.status == 'PENDING'
        && request.resource.data.visibility == 'PUBLIC'
        && request.resource.data.publicApproved == false
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'authorName', 'description', 'visibility', 'displayWidth', 'displayHeight', 'status', 'publicApproved', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && (!('authorName' in request.resource.data) || (request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60))
        && (!('description' in request.resource.data) || (request.resource.data.description is string && request.resource.data.description.size() <= 240))
        && request.resource.data.visibility in ['PUBLIC', 'SPECIAL_ONLY', 'PRIVATE']
        && request.resource.data.status in ['APPROVED', 'REJECTED']
        && request.resource.data.publicApproved == (request.resource.data.status == 'APPROVED' && request.resource.data.visibility == 'PUBLIC')
        && request.resource.data.updatedAt is string;
      allow delete: if isAdmin();
    }

    // Organización pública de la biblioteca. Los grupos pueden referenciar tanto
    // stickers base como aportaciones aprobadas sin alterar sus archivos originales.
    match /stickerLibrary/{configId} {
      allow get: if configId == 'catalog';
      allow list: if false;
      allow create, update: if configId == 'catalog'
        && isAdmin()
        && request.resource.data.keys().hasOnly(['groups', 'assignments', 'updatedAt'])
        && request.resource.data.groups is list
        && request.resource.data.groups.size() <= 50
        && request.resource.data.assignments is map
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    // Avisos privados de primer registro. El UID como identificador vuelve la
    // creación idempotente: una cuenta sólo puede generar un aviso inicial.
    match /registrationNotifications/{notificationId} {
      allow get, list: if isAdmin();
      allow create: if signedIn()
        && notificationId == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'email', 'source', 'createdAt', 'read'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'source', 'createdAt', 'read'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.source in ['GENERAL', 'BRATTY_INVITATION']
        && request.resource.data.createdAt is string
        && request.resource.data.read == false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'readBy'])
        && request.resource.data.read == true
        && request.resource.data.readAt is string
        && request.resource.data.readBy == request.auth.uid;
      allow delete: if false;
    }

    // Bitácora privada e inmutable de las últimas moderaciones consultadas por
    // el panel. Sólo administración puede crear o leer eventos.
    match /moderationEvents/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['id', 'targetId', 'targetKind', 'contributionType', 'action', 'authorName', 'moderatorUid', 'moderatorName', 'moderatorEmail', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'targetId', 'targetKind', 'contributionType', 'action', 'authorName', 'pageNumber', 'moderatorUid', 'moderatorName', 'moderatorEmail', 'createdAt'])
        && request.resource.data.id == eventId
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 160
        && request.resource.data.targetKind in ['CONTRIBUTION', 'STICKER']
        && request.resource.data.contributionType is string
        && request.resource.data.contributionType.size() <= 60
        && request.resource.data.action in ['APPROVED', 'REJECTED', 'DELETED']
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 100
        && (!('pageNumber' in request.resource.data)
          || (request.resource.data.pageNumber is int
            && request.resource.data.pageNumber >= 1
            && request.resource.data.pageNumber <= 100))
        && request.resource.data.moderatorUid == request.auth.uid
        && request.resource.data.moderatorName is string
        && request.resource.data.moderatorName.size() <= 100
        && request.resource.data.moderatorEmail is string
        && request.resource.data.moderatorEmail.size() <= 160
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }
    // Las reacciones se almacenan por usuario para impedir votos anónimos o duplicados.
    match /elementReactions/{reactionId} {
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['elementId', 'userId', 'displayName', 'createdAt'])
        && request.resource.data.elementId is string
        && request.resource.data.elementId.size() <= 160
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && reactionId == request.resource.data.elementId + '_' + request.auth.uid
        && request.resource.data.createdAt is string;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && reactionId == resource.data.elementId + '_' + request.auth.uid;
    }

    // Fuente editorial privada. Sólo administración puede crear o mutar noticias.
    match /news/{newsId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'draft';
      // El slug queda congelado desde la primera publicación para conservar enlaces compartidos.
      allow update: if isAdmin()
        && (!('publishedAt' in resource.data)
          || request.resource.data.slug == resource.data.slug)
        // La primera transición a published debe incluir el evento outbox en la misma transacción.
        && (!(request.resource.data.status == 'published' && resource.data.status != 'published')
          || existsAfter(/databases/$(database)/documents/newsPublishingEvents/$(newsId)));
    }

    // Reserva transaccional de slugs para evitar URLs ambiguas o reutilizadas.
    match /newsSlugs/{slug} {
      allow read, create, update, delete: if isAdmin();
    }

    // Proyección pública creada al publicar; los borradores nunca se copian aquí.
    match /publishedNews/{newsId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && request.resource.data.status == 'published'
        && request.resource.data.visible == true
        && getAfter(/databases/$(database)/documents/news/$(newsId)).data.status == 'published';
      allow delete: if isAdmin();
    }

    // Outbox idempotente: un documento por primera publicación de cada noticia.
    match /newsPublishingEvents/{newsId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.type == 'NEWS_PUBLISHED'
        && request.resource.data.newsId == newsId;
      allow update, delete: if false;
    }

    // Consentimiento y entregas pertenecen al backend. El cliente admin sólo puede auditar.
    match /whatsappSubscribers/{subscriberId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /newsDeliveries/{deliveryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Apariencia pública aislada de Brattycharts. El listado de IDs forma parte
    // de la misma transacción y limita el catálogo a veinte fondos.
    match /brattychartsSettings/{settingsId} {
      allow get: if settingsId == 'landing';
      allow list: if false;
      allow create, update: if settingsId == 'landing'
        && isAdmin()
        && request.resource.data.keys().hasAll(['backgroundIds', 'slideshowIntervalMs', 'transitionMs', 'videoEnabled', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['backgroundIds', 'slideshowIntervalMs', 'transitionMs', 'videoEnabled', 'videoUrl', 'videoStoragePath', 'videoOriginalName', 'videoContentType', 'videoDurationSeconds', 'updatedAt'])
        && request.resource.data.backgroundIds is list
        && request.resource.data.backgroundIds.size() <= 20
        && request.resource.data.backgroundIds.toSet().size() == request.resource.data.backgroundIds.size()
        && request.resource.data.slideshowIntervalMs is int
        && request.resource.data.slideshowIntervalMs >= 3000
        && request.resource.data.slideshowIntervalMs <= 30000
        && request.resource.data.transitionMs is int
        && request.resource.data.transitionMs >= 200
        && request.resource.data.transitionMs <= 5000
        && request.resource.data.videoEnabled is bool
        && (!request.resource.data.videoEnabled || (
          request.resource.data.videoUrl is string
          && request.resource.data.videoUrl.size() <= 1000
          && request.resource.data.videoStoragePath == 'video/current'
          && request.resource.data.videoOriginalName is string
          && request.resource.data.videoOriginalName.size() <= 180
          && request.resource.data.videoContentType in ['video/mp4', 'video/quicktime', 'video/webm']
          && request.resource.data.videoDurationSeconds is number
          && request.resource.data.videoDurationSeconds > 0
          && request.resource.data.videoDurationSeconds <= 300
        ))
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /brattychartsBackgrounds/{backgroundId} {
      allow get, list: if true;
      allow create: if isAdmin()
        && getAfter(/databases/$(database)/documents/brattychartsSettings/landing).data.backgroundIds.hasAny([backgroundId])
        && request.resource.data.keys().hasAll(['id', 'name', 'imageUrl', 'storagePath', 'enabled', 'selected', 'order', 'fit', 'position', 'overlayOpacity', 'blurPx', 'createdAt', 'updatedAt'])
        && request.resource.data.id == backgroundId
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 1000
        && request.resource.data.storagePath is string && request.resource.data.storagePath.matches('backgrounds/' + backgroundId + '[.](jpg|png|webp)')
        && request.resource.data.enabled is bool
        && request.resource.data.selected is bool
        && request.resource.data.order is number
        && request.resource.data.fit in ['cover', 'contain', 'repeat', 'extended']
        && request.resource.data.position in ['top left', 'top center', 'top right', 'center left', 'center center', 'center right', 'bottom left', 'bottom center', 'bottom right']
        && request.resource.data.overlayOpacity is number && request.resource.data.overlayOpacity >= 0 && request.resource.data.overlayOpacity <= 0.85
        && request.resource.data.blurPx is number && request.resource.data.blurPx >= 0 && request.resource.data.blurPx <= 16
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'enabled', 'selected', 'order', 'fit', 'position', 'overlayOpacity', 'blurPx', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.enabled is bool
        && request.resource.data.selected is bool
        && request.resource.data.order is number
        && request.resource.data.fit in ['cover', 'contain', 'repeat', 'extended']
        && request.resource.data.position in ['top left', 'top center', 'top right', 'center left', 'center center', 'center right', 'bottom left', 'bottom center', 'bottom right']
        && request.resource.data.overlayOpacity is number && request.resource.data.overlayOpacity >= 0 && request.resource.data.overlayOpacity <= 0.85
        && request.resource.data.blurPx is number && request.resource.data.blurPx >= 0 && request.resource.data.blurPx <= 16;
      allow delete: if isAdmin()
        && !getAfter(/databases/$(database)/documents/brattychartsSettings/landing).data.backgroundIds.hasAny([backgroundId]);
    }

    // Reserved for the future comments feature. Public visitors can only read approved comments.
    match /comments/{commentId} {
      allow get, list: if resource.data.moderationStatus == 'APPROVED';
      allow create: if signedIn()
        && request.resource.data.moderationStatus == 'PENDING'
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Denegación por defecto: toda colección nueva debe declarar su contrato explícitamente.
    match /{document=**} { allow read, write: if false; }
  }
}
